{
  "compilerOptions": {
    /* Namespaces + outFile concatenate every module into ONE classic script,
       so index.html still opens straight from disk over file:// with no server
       and no bundler. outFile is only legal with module "none"/"system"/"amd". */
    "module": "none",
    "outFile": "simulation.js",
    "rootDir": "src",

    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "removeComments": false,
    "newLine": "lf"
  },

  /* Explicit order: with outFile the emit order is the order given here. */
  "files": [
    "src/constants.ts",
    "src/util.ts",
    "src/params.ts",
    "src/world.ts",
    "src/river.ts",
    "src/geo.ts",
    "src/climate.ts",
    "src/flora.ts",
    "src/biome.ts",
    "src/life.ts",
    "src/evolution.ts",
    "src/spontaneous.ts",
    "src/stories-plants.ts",
    "src/stories-animals.ts",
    "src/civ.ts",
    "src/save.ts",
    "src/sprites.ts",
    "src/terrainart.ts",
    "src/tilecache.ts",
    "src/ambient.ts",
    "src/render.ts",
    "src/maplegend.ts",
    "src/ui.ts",
    "src/charts.ts",
    "src/sliders.ts",
    "src/windows.ts",
    "src/panels.ts",
    "src/historyview.ts",
    "src/report.ts",
    "src/graphs.ts",
    "src/gaia.ts",
    "src/modelscenes.ts",
    "src/modelhero.ts",
    "src/scenekit.ts",
    "src/films/parts-sea.ts",
    "src/films/parts-green.ts",
    "src/films/parts-bloom.ts",
    "src/films/parts-land.ts",
    "src/films/cells.ts",
    "src/films/eukaryotes.ts",
    "src/films/marineAlgae.ts",
    "src/films/freshwaterAlgae.ts",
    "src/films/landPlants.ts",
    "src/films/mosses.ts",
    "src/films/vascular.ts",
    "src/films/clubmosses.ts",
    "src/films/ferns.ts",
    "src/films/firstTrees.ts",
    "src/films/seedPlants.ts",
    "src/films/conifers.ts",
    "src/films/flowering.ts",
    "src/films/broadleaf.ts",
    "src/films/grasses.ts",
    "src/films/carnivorous.ts",
