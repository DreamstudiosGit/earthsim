{
  "name": "simearth-2-0",
  "version": "0.6.0",
  "private": true,
  "description": "Ein Natur- und Evolutionsspiel als moderner Nachfolger von SimEarth: The Living Planet (Maxis, 1990).",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"tests/*.test.js\"",
